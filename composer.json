{
    "name": "visualbuilder/filament-screenshot-catalogue",
    "description": "Capture every page of a Filament v5 panel at multiple viewports and modes, upload to S3, generate a browsable index. Drop-in tooling for visual QA, design reviews, marketing assets, and AI-driven visual regression.",
    "keywords": [
        "visualbuilder",
        "filament",
        "screenshots",
        "playwright",
        "visual-regression",
        "agentic"
    ],
    "homepage": "https://github.com/visualbuilder/filament-screenshot-catalogue",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Visual Builder",
            "email": "support@ekouk.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/bus": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Visualbuilder\\FilamentScreenshotCatalogue\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Visualbuilder\\FilamentScreenshotCatalogue\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visualbuilder\\FilamentScreenshotCatalogue\\FilamentScreenshotCatalogueServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
